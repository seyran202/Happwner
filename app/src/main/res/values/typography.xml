<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Apple HIG inspired type scale. SF Pro is not redistributable, so the
        platform sans-serif (Roboto) is used with SF-like sizes, weights and
        tight tracking.
    -->
    <style name="TextAppearance.Happwner" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Happwner.LargeTitle" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_large_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Happwner.Title1" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_title_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Happwner.Title2" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Happwner.NavTitle" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_nav</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/toolbar_text</item>
    </style>

    <style name="TextAppearance.Happwner.Headline" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Happwner.Body" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="TextAppearance.Happwner.Footnote" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Happwner.Caption" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_tiny</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- iOS grouped-table section headers: small, uppercase, secondary label -->
    <style name="TextAppearance.Happwner.SectionHeader" parent="TextAppearance.Happwner">
        <item name="android:textSize">@dimen/text_size_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Happwner.TextView" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>
