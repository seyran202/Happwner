<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- iOS filled button: 14dp continuous corner, semibold 17sp label -->
    <style name="Widget.Happwner.Button.Primary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="backgroundTint">@color/apple_blue_button</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- iOS tinted / glass button -->
    <style name="Widget.Happwner.Button.Secondary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/apple_blue</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="backgroundTint">@color/glass_button_bg</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="rippleColor">@color/brand_purple_secondary_highlight</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- iOS style switch: green track when on, white thumb -->
    <style name="Widget.Happwner.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/apple_switch_thumb</item>
        <item name="trackTint">@color/apple_switch_track</item>
        <item name="useMaterialThemeColors">false</item>
    </style>

    <!-- Frosted iOS text field -->
    <style name="Widget_Happwner_TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/glass_bg</item>
        <item name="boxStrokeColor">@color/apple_blue_field_stroke</item>
        <item name="boxStrokeErrorColor">@color/error_red</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="errorTextColor">@color/error_red</item>
        <item name="hintTextColor">@color/text_input_hint_selector</item>
        <item name="android:textColorHint">@color/text_input_hint_selector</item>
        <item name="cursorColor">@color/apple_blue</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay_Happwner_TextInput</item>
        <item name="errorIconDrawable">@null</item>
    </style>
</resources>
