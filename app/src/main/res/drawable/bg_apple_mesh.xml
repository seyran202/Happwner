<?xml version="1.0" encoding="utf-8"?>
<!--
    Soft aurora / mesh gradient backdrop. It is intentionally blurry so every
    translucent glass surface above it reads as frosted glass.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/apple_mesh_base" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.08"
                android:centerY="0.02"
                android:endColor="#0073C7FF"
                android:gradientRadius="520dp"
                android:startColor="#9973C7FF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.10"
                android:endColor="#00AF52DE"
                android:gradientRadius="500dp"
                android:startColor="#8CAF52DE"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.0"
                android:centerY="0.55"
                android:endColor="#00FF6482"
                android:gradientRadius="520dp"
                android:startColor="#66FF6482"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.66"
                android:endColor="#0034C759"
                android:gradientRadius="470dp"
                android:startColor="#5534C759"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.55"
                android:centerY="1.05"
                android:endColor="#00FF9500"
                android:gradientRadius="600dp"
                android:startColor="#55FF9500"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
